{
  "name": "@janela/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Tauri app: window, native menus, notifications, and the socket bridge.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build",
    "bundle": "bun run sidecar && tauri build && bun run verify-bundle",
    "bundle:release": "bun run sidecar && tauri build --config src-tauri/tauri.release.conf.json && bun run verify-bundle",
    "clean": "rm -rf dist src-tauri/target *.tsbuildinfo",
    "dev": "bun run sidecar && tauri dev",
    "sidecar": "bun run scripts/sidecar.ts",
    "test": "bun test",
    "typecheck": "tsc --build",
    "updater-manifest": "bun run scripts/updater-manifest.ts",
    "verify-bundle": "bun run scripts/verify-bundle.ts"
  },
  "dependencies": {
    "@janela/client": "workspace:*",
    "@janela/core": "workspace:*",
    "@janela/design": "workspace:*",
    "@janela/protocol": "workspace:*",
    "@janela/support": "workspace:*",
    "@janela/terminal-ui": "workspace:*",
    "@janela/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2",
    "@tauri-apps/plugin-log": "2.9.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.12.0",
    "effect": "4.0.0-rc.115",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@janela/test-support": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-react": "6.1.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}

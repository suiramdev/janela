{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core APIs, logging, notifications, the directory picker, and opening a session's directory in Finder or Terminal.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "notification:default",
    "dialog:allow-open",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "/**", "app": "Terminal" }]
    }
  ]
}

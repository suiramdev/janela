{
  "name": "@janela/janelad",
  "version": "0.0.0",
  "private": true,
  "description": "The daemon executable. Process plumbing only.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build --compile --minify --sourcemap --target=bun-darwin-arm64 --outfile janelad src/main.ts",
    "clean": "rm -rf janelad dist *.tsbuildinfo",
    "dev": "bun run src/main.ts --foreground",
    "test": "bun test",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@janela/core": "workspace:*",
    "@janela/daemon": "workspace:*",
    "@janela/db": "workspace:*",
    "@janela/git": "workspace:*",
    "@janela/integrations": "workspace:*",
    "@janela/protocol": "workspace:*",
    "@janela/pty": "workspace:*",
    "@janela/session": "workspace:*",
    "@janela/support": "workspace:*",
    "@janela/terminal": "workspace:*",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@janela/test-support": "workspace:*"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".oxlintrc.json", ".oxfmtrc.json"],
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "build:native": {
      "inputs": ["native/**"],
      "outputs": [
        "native/target/release/*.dylib",
        "native/target/release/*.so",
        "native/target/release/*.dll"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "outputs": [".tsbuildinfo", "dist/**/*.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "build:native"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "generate", "build:native"],
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["^build", "build"],
      "outputs": ["target/release/bundle/**"],
      "cache": false,
      // Signing and notarization credentials. Turbo's strict env mode hides
      // everything undeclared, and a bundle that silently comes out ad-hoc because a
      // variable never reached `tauri build` is a release failure that shows up on a
      // user's machine rather than here.
      "passThroughEnv": [
        "APPLE_SIGNING_IDENTITY",
        "APPLE_CERTIFICATE",
        "APPLE_CERTIFICATE_PASSWORD",
        "APPLE_ID",
        "APPLE_PASSWORD",
        "APPLE_TEAM_ID",
        "APPLE_API_KEY",
        "APPLE_API_ISSUER",
        "APPLE_API_KEY_PATH",
        "APPLE_PROVIDER_SHORT_NAME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}

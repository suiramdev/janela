<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>

	<!-- Janela is a single-window-per-workspace developer tool, not a document app. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<!-- Sudden termination must stay off: killing the app without teardown orphans
	     child shells and leaves worktrees in a half-written state. -->
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 The Janela Authors. MIT Licensed.</string>

	<!-- Usage descriptions. Janela itself never asks for these, but a child process
	     the user starts (a test runner, a build script, an agent) may trigger the
	     prompt, and macOS attributes it to us. Wording explains that honestly. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Janela needs access so the terminals you open can read and write files in this folder.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Janela needs access so the terminals you open can read and write files in this folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Janela needs access so the terminals you open can read and write files in this folder.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Janela needs access so the terminals you open can read and write files on this volume.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Janela needs access so the terminals you open can read and write files on this volume.</string>
</dict>
</plist>

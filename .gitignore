# ---- Generated Xcode project -------------------------------------------------
# project.yml is the source of truth; the .xcodeproj is generated by XcodeGen.
# Never commit it: pbxproj files do not merge and coding agents corrupt them.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/xcshareddata/

# ---- Build output ------------------------------------------------------------
.build/
.swiftpm/
DerivedData/
build/
*.o
*.a
*.dSYM/
*.ipa
*.xcarchive

# ---- Local tooling / caches --------------------------------------------------
.janela/
# Coding-agent scratch state (pi). Research worth keeping lives in docs/research/.
.pi/
.claude/
.aider*
*.xcresult
*.profraw
*.profdata
timeline.trace/
*.trace

# ---- macOS -------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Editors -----------------------------------------------------------------
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---- Secrets & signing -------------------------------------------------------
*.p12
*.mobileprovision
.env
.env.*
!.env.example
Secrets.xcconfig
notarization-credentials.json

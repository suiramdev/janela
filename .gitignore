# ---- Dependencies --------------------------------------------------------------
node_modules/
.bun/

# Spikes are kept as evidence for the ADRs, but their dependencies and build
# output are not. See spikes/README.md.
spikes/**/node_modules/
spikes/**/generated/
spikes/**/*.sqlite*
spikes/**/bun.lock

# ---- Build output -------------------------------------------------------------
dist/
build/
.turbo/
*.tsbuildinfo

# Rust: the PTY cdylib in packages/pty/native and Tauri's shell in
# apps/desktop/src-tauri. Both are built artifacts; only their sources are
# committed. See docs/decisions/0021-pty-native-layer.md.
target/

# Prisma's generated client. Regenerated by `bun run generate`, and never
# committed — a generated client that disagrees with the schema is worse than no
# client at all. See docs/decisions/0019-prisma-sql-layer.md.
generated/
packages/db/generated/

# The compiled daemon sidecar and its sourcemap.
apps/desktop/src-tauri/binaries/
apps/daemon/janelad*
apps/daemon/main.js.map

# ---- Local tooling / caches ---------------------------------------------------
# Janela's own runtime directory: the daemon socket lives at ~/.janela/run, but a
# development run with --foreground may place one here.
.janela/
# Coding-agent scratch state. Research worth keeping lives in docs/research/.
.pi/
.claude/
.aider*
*.log

# ---- Databases ----------------------------------------------------------------
# A developer's local janela.sqlite is their own session list.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ---- macOS --------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Editors ------------------------------------------------------------------
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---- Secrets & signing --------------------------------------------------------
# Janela is Developer ID signed and notarized outside the App Store, for both
# binaries in the bundle. See docs/decisions/0008-sandboxing-and-distribution.md.
*.p12
*.mobileprovision
.env
.env.*
!.env.example
notarization-credentials.json

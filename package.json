{
  "name": "janela",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun install && bun run generate && bun run build:native",
    "build": "turbo run build",
    "build:native": "turbo run build:native",
    "generate": "turbo run generate",
    "typecheck": "tsc --build",
    "test": "bun test",
    "lint": "oxlint --deny-warnings && oxfmt --check . && bun run check:layers",
    "format": "oxfmt . && oxlint --fix",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:layers": "bun run scripts/check-layers.ts",
    "app": "turbo run dev --filter=@janela/desktop",
    "app:build": "turbo run bundle --filter=@janela/desktop",
    "daemon:build": "turbo run build --filter=@janela/janelad",
    "daemon:restart": "bun run scripts/daemon-restart.ts",
    "daemon:status": "bun run scripts/daemon-status.ts",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}

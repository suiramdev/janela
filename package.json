{
  "name": "janela",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun install && bun run generate && bun run build:native",
    "build": "turbo run build",
    "build:native": "turbo run build:native",
    "generate": "turbo run generate",
    "typecheck": "tsc --build",
    "test": "turbo run test -- --pass-with-no-tests && bun test scripts",
    "lint": "oxlint --deny-warnings && oxfmt --check . && bun run check:layers && bun run check:fsd",
    "format": "oxfmt . && oxlint --fix",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:layers": "bun run scripts/check-layers.ts",
    "check:fsd": "bun run --cwd packages/ui lint:fsd",
    "desktop": "bun run scripts/dev.ts",
    "desktop:only": "turbo run dev --filter=@janela/desktop",
    "desktop:build": "turbo run bundle --filter=@janela/desktop",
    "web": "bun run scripts/dev.ts --web",
    "web:only": "turbo run dev --filter=@janela/gateway --filter=@janela/web",
    "web:isolated": "bun run scripts/dev.ts --web --isolated",
    "web:build": "turbo run build --filter=@janela/web",
    "gateway": "bun run --cwd apps/gateway start",
    "daemon": "bun run --cwd apps/daemon dev",
    "daemon:build": "turbo run build --filter=@janela/janelad",
    "daemon:restart": "bun run scripts/daemon-restart.ts",
    "daemon:status": "bun run scripts/daemon-status.ts",
    "version": "bun run scripts/version.ts",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@janela/protocol": "workspace:*",
    "@shadcn/lint": "^0.1.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "1.85.0",
    "oxslop": "^0.1.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "//": "oxlint is pinned exactly: oxslop declares a peer of 1.85.0 and its rules are built against that release of the JS plugin API, which is still alpha and has broken across minors. A range here would let `bun install` drift the linter out from under the plugin."
}
